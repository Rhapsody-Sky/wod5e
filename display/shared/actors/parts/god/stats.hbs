<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="grid grid-2col flexrow spc-stats-body">
        <div>
            <div class="god-attributes">
                <div class="resource-label field-header flex-center">
                    {{localize "WOD5E.God.Attributes"}}
                </div>

                <div class="god-attribute-list">
                    {{#each divineAttributes as |attribute|}}
                        <div class="god-attribute resource-content flexrow flex-center {{#if attribute.selected}}is-selected{{/if}}">
                            <button type="button" class="god-attribute-invocation"
                                data-action="selectGodAttribute"
                                data-attribute-id="{{attribute.id}}"
                                aria-pressed="{{attribute.selected}}"
                                aria-describedby="{{../godAttributeSelectionStatusId}}"
                                title="{{attribute.pairSelectionLabel}}">
                                <span class="god-attribute-icon" aria-hidden="true">
                                    <img src="{{attribute.icon}}" alt="" />
                                </span>
                                <span class="god-attribute-label">{{attribute.label}}</span>
                                <i class="fa-solid fa-link god-attribute-pair" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="rollable god-attribute-single-roll"
                                data-action="rollSingleGodAttribute"
                                data-attribute-id="{{attribute.id}}"
                                aria-label="{{attribute.singleRollLabel}}"
                                title="{{attribute.singleRollLabel}}">
                                <i class="fa-solid fa-dice-d10" aria-hidden="true"></i>
                            </button>
                            {{#if ../locked}}
                                <span class="resource stat-resource-background">{{attribute.value}}</span>
                            {{else}}
                                <input class="god-attribute-value" type="number" min="0"
                                    name="system.divineattributes.{{attribute.id}}.value"
                                    value="{{attribute.value}}" data-dtype="Number" />
                            {{/if}}
                        </div>
                    {{/each}}
                </div>

                <p id="{{godAttributeSelectionStatusId}}" class="god-attribute-selection-status" aria-live="polite">
                    {{godAttributeSelectionHint}}
                </p>

                <button type="button" class="rollable god-attribute-roll" data-action="godAttributeRoll">
                    <i class="fa-solid fa-dice-d10"></i>
                    {{localize "WOD5E.God.RollTwoAttributes"}}
                </button>
            </div>

            {{> "systems/wod5e/display/shared/actors/parts/spc/exceptional-dice-pools.hbs"}}

            {{#if showDisciplines}}
                {{> "systems/wod5e/display/shared/actors/parts/spc/spc-disciplines.hbs"}}
            {{/if}}

            {{#if showGifts}}
                {{> "systems/wod5e/display/shared/actors/parts/spc/spc-gifts.hbs"}}
            {{/if}}

            {{#if showEdges}}
                {{> "systems/wod5e/display/shared/actors/parts/spc/spc-edges.hbs"}}
            {{/if}}
        </div>

        <div>
            {{> "systems/wod5e/display/shared/actors/parts/spc/spc-traits.hbs"}}
            {{> "systems/wod5e/display/shared/actors/parts/spc/spc-conditions.hbs"}}
        </div>
    </div>
</section>
